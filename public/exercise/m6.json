          "solution": [
            "import io",
            "import pandas as pd",
            "",
            "RAW = \"\"\"Order ID,Date ,category,Amount,Region",
            "1001,2026-01-05,Books,12.50,Phnom Penh",
            "1002,2026-01-17,Toys,45.00,",
            "1003,2026-02-02,Books,,Siem Reap",
            "1004,2026-02-14,Games,80.00,Phnom Penh",
            "1005,2026-03-03,Toys,25.00,Kampot",
            "1005,2026-03-03,Toys,25.00,Kampot",
            "1006,2026-03-21,Books,-15.00,Phnom Penh",
            "1007,not a date,Games,60.00,Kampot",
            "1008,2026-04-08,Games,120.00,Siem Reap",
            "1009,2026-04-19,Books,35.50,Phnom Penh",
            "1010,2026-05-02,Toys,55.00,Kampot",
            "\"\"\"",
            "",
            "df = pd.read_csv(io.StringIO(RAW))",
            "",
            "df.columns = df.columns.str.strip().str.lower().str.replace(\" \", \"_\")",
            "print(list(df.columns))",
            "",
            "dates = pd.to_datetime(df[\"date\"], errors=\"coerce\")",
            "amounts = pd.to_numeric(df[\"amount\"], errors=\"coerce\")",
            "",
            "print(dates.isna().sum(), \"bad dates\")",
            "print(amounts.isna().sum(), \"bad amounts\")",
            "print((amounts < 0).sum(), \"negative amounts\")"
          ],
          "explain": "`errors=\"coerce\"` is what lets you count the damage instead of crashing on the first bad value. Counting first, deciding second."
        }
