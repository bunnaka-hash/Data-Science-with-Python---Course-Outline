    {
      "topic": "Clean Data",
      "title": "Step 2 — clean, with reasons",
      "lead": "Every decision here throws data away, so every decision needs a reason you can say out loud.",
      "packages": ["pandas"],
      "tasks": [
        {
          "title": "The full cleaning pass",
          "brief": "Run the whole sequence — dedupe, convert, drop, fill, filter — and report how many rows survive.",
          "steps": [
            "Drop exact duplicate rows first",
            "Convert `date` and `amount` with `errors=\"coerce\"`",
            "Drop rows with no date or no amount — they cannot be analysed",
            "Fill a missing region with `\"unknown\"` — the row is still usable",
            "Drop the negative amounts; they are refunds and out of scope"
          ],
          "starter": [
            "import io",
            "import pandas as pd",
            "",
            "RAW = \"\"\"Order ID,Date ,category,Amount,Region",
            "1001,2026-01-05,Books,12.50,Phnom Penh",
            "1002,2026-01-17,Toys,45.00,",
            "1003,2026-02-02,Books,,Siem Reap",
            "1004,2026-02-14,Games,80.00,Phnom Penh",
            "1005,2026-03-03,Toys,25.00,Kampot",
            "1005,2026-03-03,Toys,25.00,Kampot",
            "1006,2026-03-21,Books,-15.00,Phnom Penh",
            "1007,not a date,Games,60.00,Kampot",
            "1008,2026-04-08,Games,120.00,Siem Reap",
            "1009,2026-04-19,Books,35.50,Phnom Penh",
            "1010,2026-05-02,Toys,55.00,Kampot",
            "\"\"\"",
            "",
            "df = pd.read_csv(io.StringIO(RAW))",
            "df.columns = df.columns.str.strip().str.lower().str.replace(\" \", \"_\")",
            "",
            "# clean it, then print:",
            "#   the rows you started with",
            "#   the rows you kept",
            "#   the regions that remain, sorted",
            "#   the total amount, rounded to two places"
          ],
          "expected": [
            "11 rows in",
            "7 rows kept",
            "['Kampot', 'Phnom Penh', 'Siem Reap', 'unknown']",
            "total 373.0"
          ],
          "hint": "Keep the starting row count in a variable before you clean, or you will have nothing left to compare against.",
          "solution": [
            "import io",
            "import pandas as pd",
            "",
            "RAW = \"\"\"Order ID,Date ,category,Amount,Region",
            "1001,2026-01-05,Books,12.50,Phnom Penh",
            "1002,2026-01-17,Toys,45.00,",
            "1003,2026-02-02,Books,,Siem Reap",
            "1004,2026-02-14,Games,80.00,Phnom Penh",
            "1005,2026-03-03,Toys,25.00,Kampot",
            "1005,2026-03-03,Toys,25.00,Kampot",
            "1006,2026-03-21,Books,-15.00,Phnom Penh",
            "1007,not a date,Games,60.00,Kampot",
            "1008,2026-04-08,Games,120.00,Siem Reap",
            "1009,2026-04-19,Books,35.50,Phnom Penh",
            "1010,2026-05-02,Toys,55.00,Kampot",
            "\"\"\"",
            "",
            "df = pd.read_csv(io.StringIO(RAW))",
            "df.columns = df.columns.str.strip().str.lower().str.replace(\" \", \"_\")",
            "",
            "started = len(df)",
            "print(started, \"rows in\")",
            "",
            "df = df.drop_duplicates()",
            "df[\"date\"] = pd.to_datetime(df[\"date\"], errors=\"coerce\")",
            "df[\"amount\"] = pd.to_numeric(df[\"amount\"], errors=\"coerce\")",
            "",
            "df = df.dropna(subset=[\"date\", \"amount\"])",
            "df[\"region\"] = df[\"region\"].fillna(\"unknown\")",
            "df = df[df[\"amount\"] >= 0]",
            "",
            "print(len(df), \"rows kept\")",
            "print(sorted(df[\"region\"].unique().tolist()))",
            "print(\"total\", round(float(df[\"amount\"].sum()), 2))"
          ],
          "explain": "Four of eleven rows are gone. On a real project that ratio goes in the report — an analysis that silently discards a third of the data is not trustworthy."
        },
