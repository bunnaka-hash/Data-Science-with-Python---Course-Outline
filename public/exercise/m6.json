    {
      "topic": "Analyze Data",
      "title": "Step 3 — answer the question",
      "lead": "The question: which category drives revenue, and how did revenue move month to month?",
      "packages": ["pandas"],
      "tasks": [
        {
          "title": "Revenue by category",
          "brief": "Total the revenue per category, name the leader, and work out each category's share of the total.",
          "steps": [
            "Group by category and sum the amount",
            "Sort highest first, then read the first index label for the leader",
            "Share is each total divided by the overall total, times 100"
          ],
          "starter": [
            "import io",
            "import pandas as pd",
            "",
            "RAW = \"\"\"order_id,date,category,amount,region",
            "1001,2026-01-05,Books,12.50,Phnom Penh",
            "1002,2026-01-17,Toys,45.00,unknown",
            "1004,2026-02-14,Games,80.00,Phnom Penh",
            "1005,2026-03-03,Toys,25.00,Kampot",
            "1008,2026-04-08,Games,120.00,Siem Reap",
            "1009,2026-04-19,Books,35.50,Phnom Penh",
            "1010,2026-05-02,Toys,55.00,Kampot",
            "\"\"\"",
            "",
            "df = pd.read_csv(io.StringIO(RAW), parse_dates=[\"date\"])",
            "",
            "# 1. revenue per category, highest first, as a dictionary",
            "",
            "# 2. the leading category",
            "",
            "# 3. each category's share of revenue, one decimal place",
            "",
            "# 4. the number of orders per category"
          ],
          "expected": [
            "{'Games': 200.0, 'Toys': 125.0, 'Books': 48.0}",
            "top Games",
            "{'Games': 53.6, 'Toys': 33.5, 'Books': 12.9}",
            "{'Books': 2, 'Games': 2, 'Toys': 3}"
          ],
          "hint": "`by_category.index[0]` is the leader once the Series is sorted descending.",
          "solution": [
            "import io",
            "import pandas as pd",
            "",
            "RAW = \"\"\"order_id,date,category,amount,region",
            "1001,2026-01-05,Books,12.50,Phnom Penh",
            "1002,2026-01-17,Toys,45.00,unknown",
            "1004,2026-02-14,Games,80.00,Phnom Penh",
            "1005,2026-03-03,Toys,25.00,Kampot",
            "1008,2026-04-08,Games,120.00,Siem Reap",
            "1009,2026-04-19,Books,35.50,Phnom Penh",
            "1010,2026-05-02,Toys,55.00,Kampot",
            "\"\"\"",
            "",
            "df = pd.read_csv(io.StringIO(RAW), parse_dates=[\"date\"])",
            "",
            "by_category = df.groupby(\"category\")[\"amount\"].sum().sort_values(ascending=False)",
            "print(by_category.round(2).to_dict())",
            "print(\"top\", by_category.index[0])",
            "",
            "share = (by_category / by_category.sum() * 100).round(1)",
            "print(share.to_dict())",
            "",
            "print(df.groupby(\"category\").size().to_dict())"
          ],
          "explain": "Games leads on revenue with the fewest orders of any category — two facts that only mean something side by side. That contrast is a finding; either number alone is not."
        },
        {
          "title": "Revenue month by month",
          "brief": "Resample the orders into monthly totals and print the months, the totals, and the best month.",
          "steps": [
            "Set the date as the index, then `resample(\"ME\")` and sum",
            "`d.strftime(\"%b\")` turns each month-end stamp into a short name",
            "`idxmax()` gives the index label of the largest value"
          ],
          "starter": [
            "import io",
            "import pandas as pd",
            "",
            "RAW = \"\"\"order_id,date,category,amount,region",
            "1001,2026-01-05,Books,12.50,Phnom Penh",
            "1002,2026-01-17,Toys,45.00,unknown",
            "1004,2026-02-14,Games,80.00,Phnom Penh",
            "1005,2026-03-03,Toys,25.00,Kampot",
            "1008,2026-04-08,Games,120.00,Siem Reap",
            "1009,2026-04-19,Books,35.50,Phnom Penh",
            "1010,2026-05-02,Toys,55.00,Kampot",
            "\"\"\"",
            "",
            "df = pd.read_csv(io.StringIO(RAW), parse_dates=[\"date\"])",
            "",
            "# 1. the month names, in order",
            "",
            "# 2. the monthly totals, as a list",
            "",
            "# 3. the best month and its total"
          ],
          "expected": [
            "['Jan', 'Feb', 'Mar', 'Apr', 'May']",
            "[57.5, 80.0, 25.0, 155.5, 55.0]",
            "best Apr 155.5"
          ],
          "hint": "`monthly.idxmax()` returns a timestamp — format it with `.strftime(\"%b\")` the same way as the month names.",
          "solution": [
            "import io",
            "import pandas as pd",
            "",
            "RAW = \"\"\"order_id,date,category,amount,region",
            "1001,2026-01-05,Books,12.50,Phnom Penh",
            "1002,2026-01-17,Toys,45.00,unknown",
            "1004,2026-02-14,Games,80.00,Phnom Penh",
            "1005,2026-03-03,Toys,25.00,Kampot",
            "1008,2026-04-08,Games,120.00,Siem Reap",
            "1009,2026-04-19,Books,35.50,Phnom Penh",
            "1010,2026-05-02,Toys,55.00,Kampot",
            "\"\"\"",
            "",
            "df = pd.read_csv(io.StringIO(RAW), parse_dates=[\"date\"])",
            "",
            "monthly = df.set_index(\"date\").resample(\"ME\")[\"amount\"].sum()",
            "",
            "print([d.strftime(\"%b\") for d in monthly.index])",
            "print(monthly.round(2).tolist())",
            "",
            "best = monthly.idxmax()",
            "print(\"best\", best.strftime(\"%b\"), round(float(monthly.max()), 2))"
          ],
          "explain": "resample fills in months with no orders as zero rather than skipping them, which is what keeps a monthly line chart honest about the gaps."
        }
      ]
    },
